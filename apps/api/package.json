{
  "name": "@club/api",
  "version": "1.0.0",
  "description": "Backend API for badminton club management",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "biome lint src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "audit:membership": "tsx src/scripts/auditMembershipConsistency.ts",
    "maintain:audit-retention": "tsx src/scripts/maintainAuditRetention.ts",
    "migrate:email-change-tokens": "tsx src/scripts/migrateEmailChangeTokens.ts",
    "audit:taster-session-readiness": "tsx src/scripts/checkTasterSessionReadiness.ts --dry-run",
    "check:taster-session-readiness": "tsx src/scripts/checkTasterSessionReadiness.ts --ensure-index",
    "check:runtime-readiness": "tsx src/scripts/checkRuntimeReadiness.ts",
    "audit:taster-session-source": "tsx src/scripts/consolidateTasterSessionSource.ts --dry-run",
    "apply:taster-session-source": "tsx src/scripts/consolidateTasterSessionSource.ts --apply",
    "preflight:taster-session-email-templates": "tsx src/scripts/seedEmailTemplates.ts --taster-session-preflight",
    "reconcile:taster-session-email-templates": "tsx src/scripts/seedEmailTemplates.ts --taster-session-apply",
    "seed:data": "NODE_ENV=development tsx src/scripts/seedData.ts",
    "seed:email-templates": "tsx src/scripts/seedEmailTemplates.ts",
    "audit:showcase-public-content": "tsx src/scripts/reconcileShowcasePublicContent.ts --audit",
    "reconcile:showcase-public-content": "tsx src/scripts/reconcileShowcasePublicContent.ts",
    "bootstrap:fresh-public-demo": "NODE_ENV=production tsx src/scripts/bootstrapFreshPublicDemo.ts",
    "bootstrap:production-content": "NODE_ENV=production tsx src/scripts/bootstrapCanonicalContent.ts",
    "bootstrap:super-admin": "NODE_ENV=production tsx src/scripts/manageSuperAdmin.ts --mode bootstrap",
    "recover:super-admin": "NODE_ENV=production tsx src/scripts/manageSuperAdmin.ts --mode recover",
    "db:reset": "NODE_ENV=development tsx src/scripts/seedData.ts"
  },
  "dependencies": {
    "@club/shared-types": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/debug": "^4.1.13",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "^12.0.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
