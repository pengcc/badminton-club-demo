# Run `pnpm bootstrap:local-env` from the repository root for first-time local setup.

# Required origin for public metadata during normal local runtime.
FRONTEND_URL=http://localhost:3000

# API_URL and NEXT_PUBLIC_API_URL are optional for the normal localhost path.
# The Web runtime defaults to the local API on port 3003 when they are absent.

# Intentionally public credentials for the disposable synthetic Demo Admin.
# Configure only for the Showcase public-demo runtime; never reuse real credentials.
# NEXT_PUBLIC_SHOWCASE_DEMO_EMAIL=demo.admin@club.invalid
# NEXT_PUBLIC_SHOWCASE_DEMO_PASSWORD=<public-demo-password>
