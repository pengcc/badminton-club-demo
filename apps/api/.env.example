# Development Environment Configuration
# Run `pnpm bootstrap:local-env` from the repository root for first-time local setup.
# This reference also documents optional values that bootstrap intentionally does not copy.

# Application Database Configuration
# Manual native and project Docker lifecycle: .repo-tools/development/README.md
# MONGODB_URI selects the application target; it does not manage provider lifecycle.
# The default below expects an externally managed native rs0 service on port 27018.
MONGODB_URI=mongodb://localhost:27018/badminton-club-demo-dev?replicaSet=rs0&directConnection=true
# To use the repository-owned Docker rs0 service instead, run
# `pnpm mongo:docker:start` and select port 27019 in the local-only .env.local file.
# MONGODB_URI=mongodb://localhost:27019/badminton-club-demo-dev?replicaSet=rs0&directConnection=true

# Development-only retained public-upload root. `pnpm bootstrap:local-env`
# establishes the machine-specific absolute value; do not copy this placeholder.
# DEVELOPMENT_PUBLIC_UPLOADS_ROOT=/absolute/primary-worktree/apps/api/uploads

# Persistence/integration-test MongoDB server mode. Vitest selectively loads only
# MONGO_TEST_* values from .env.local; an exported process value takes precedence.
# Standalone persistence-test entrypoints require an explicit server mode; there
# is no default and no fallback between server modes.
# MONGO_TEST_SERVER_MODE=testcontainers
# Native mode requires a server-level loopback URI for an already-running,
# direct replica-set member. Do not name badminton-club-demo-dev or any other
# application database in this URI.
# MONGO_TEST_SERVER_MODE=native
# MONGO_TEST_NATIVE_URI=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true

# Required by the read-only membership consistency audit. Supply a stable,
# private value locally; never commit the real salt.
MEMBERSHIP_AUDIT_SALT=replace-with-a-stable-local-audit-salt

# Server Configuration
PORT=3003
NODE_ENV=development

# Security

# Required outside tests. Store real key material only in the environment-owned secret file.
# BANKING_ENCRYPTION_ACTIVE_KEY_VERSION=v1
# BANKING_ENCRYPTION_KEYS={"v1":"base64-encoded-32-byte-key"}

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Showcase-only public demo boundary. The configured account remains an ordinary
# synthetic administrator and must never be an operator or real club account.
SHOWCASE_DEMO_ENABLED=false
# SHOWCASE_DEMO_ADMIN_EMAIL=demo.admin@club.invalid

# Email Configuration
# Development defaults to Ethereal even when SMTP values are present. Set the
# explicit smtp opt-in only when real SMTP delivery is intended locally.
# DEV_EMAIL_TRANSPORT=ethereal
# DEV_EMAIL_TRANSPORT=smtp
#
# Production (IONOS SMTP), or development with DEV_EMAIL_TRANSPORT=smtp:
# SMTP_HOST=smtp.ionos.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@domain.de
# SMTP_PASS=your-password
# SMTP_FROM=noreply@your-club.example
#
# Development Ethereal mode still needs SMTP_FROM as the message sender, but
# ignores configured SMTP transport credentials.
# (Emails will be caught and viewable at https://ethereal.email)
# Runtime-readiness preflight never creates Ethereal or sends mail. It validates configured
# SMTP values by default and contacts the configured transport only with --verify-smtp.

# File Upload Configuration
UPLOAD_MAX_SIZE=10mb
# Optional absolute override. Defaults to apps/api/private_uploads, which is never served publicly.
# Runtime-readiness preflight resolves symlinks and checks public/private isolation and bounded
# parent permissions without creating directories or probe files.
# MEMBERSHIP_APPLICATION_PRIVATE_UPLOAD_ROOT=/private/path

# One-off bootstrap:fresh-public-demo only; supply via the deployment environment.
# SHOWCASE_DEMO_ADMIN_PASSWORD=<public-demo-password>
# Not required by ordinary API runtime; never use a real account credential.
